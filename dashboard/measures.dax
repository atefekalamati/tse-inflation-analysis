// DAX measures of the tse_inflation semantic model (table _Measures).
// Generated by src/build_dashboard.py; identical to _Measures.tmdl.
// Units: CAGR and vol are per year; 'cum 3y' is cumulative 1402-06 to 1405-06;
// closure figures are cumulative over the stated window.

// [1 Headline] CPI 1405-06 divided by CPI 1402-06 (3.62 = prices multiplied by 3.62 in 3 years).  Format: 0.00×
'CPI growth (×)' =
    VAR CpiCum3y =
        CALCULATE (
            MAX ( risk_summary[nominal_cum_3y] ),
            REMOVEFILTERS ( dim_series ),
            risk_summary[series_code] = "cpi"
        )
    RETURN
        1 + CpiCum3y

// [1 Headline] Overall index (شاخص کل): real return, cumulative over 3 years (1402-06 to 1405-06).  Format: 0.0%;-0.0%;0.0%
'Index real cum 3y' =
    CALCULATE (
        MAX ( risk_summary[real_cum_3y] ),
        REMOVEFILTERS ( dim_series ),
        risk_summary[series_code] = "index_total"
    )

// [1 Headline] Equal-weight index: real return, cumulative over 3 years (1402-06 to 1405-06).  Format: 0.0%;-0.0%;0.0%
'Equal-weight real cum 3y' =
    CALCULATE (
        MAX ( risk_summary[real_cum_3y] ),
        REMOVEFILTERS ( dim_series ),
        risk_summary[series_code] = "index_equal_weight"
    )

// [1 Headline] How many of the 8 sample stocks had a positive real return, cumulative over 3 years, as '3 / 8'.
'Stocks beating inflation' =
    VAR Stocks =
        CALCULATETABLE (
            risk_summary,
            REMOVEFILTERS ( dim_series ),
            dim_series[type] = "stock"
        )
    VAR Winners = COUNTROWS ( FILTER ( Stocks, risk_summary[real_cum_3y] > 0 ) )
    VAR Total = COUNTROWS ( Stocks )
    RETURN
        FORMAT ( Winners, "0" ) & " / " & FORMAT ( Total, "0" )

// [1 Headline] Overall index, real change from the last close before the closure (1404-12-06) to the first close after it (1405-02-29), CPI pro-rated to those dates. Cumulative over the closure.  Format: 0.0%;-0.0%;0.0%
'Closure real loss (pro-rated)' =
    CALCULATE (
        MAX ( closure_summary[real_prorated] ),
        REMOVEFILTERS ( dim_series ),
        closure_summary[series_code] = "index_total",
        closure_summary[window] = "on_reopening"
    )

// [1 Headline] Sensitivity for the closure loss: CPI from end of 1404-11 to end of 1405-02.  Format: 0.0%;-0.0%;0.0%
'Closure real loss (whole months)' =
    CALCULATE (
        MAX ( closure_summary[real_whole_months] ),
        REMOVEFILTERS ( dim_series ),
        closure_summary[series_code] = "index_total",
        closure_summary[window] = "on_reopening"
    )

// [2 Selected series] series_code of the single series in the filter context; the overall index when none or several.
'Selected series code' =
    IF (
        HASONEVALUE ( dim_series[series_code] ),
        VALUES ( dim_series[series_code] ),
        "index_total"
    )

// [2 Selected series] Persian name of the selected series.
'Selected series' =
    VAR SeriesCode = [Selected series code]
    RETURN
        CALCULATE (
            MAX ( dim_series[series_fa] ),
            REMOVEFILTERS ( dim_series ),
            dim_series[series_code] = SeriesCode
        )

// [2 Selected series] Real CAGR of the selected series, per year.  Format: 0.0%;-0.0%;0.0%
'Selected real CAGR' =
    VAR SeriesCode = [Selected series code]
    RETURN
        CALCULATE (
            MAX ( risk_summary[real_cagr] ),
            REMOVEFILTERS ( dim_series ),
            risk_summary[series_code] = SeriesCode
        )

// [2 Selected series] Volatility of monthly real returns of the selected series, annualized (per year).  Format: 0.0%;-0.0%;0.0%
'Selected real vol' =
    VAR SeriesCode = [Selected series code]
    RETURN
        CALCULATE (
            MAX ( risk_summary[real_vol_per_year] ),
            REMOVEFILTERS ( dim_series ),
            risk_summary[series_code] = SeriesCode
        )

// [2 Selected series] Largest peak-to-trough fall of the selected series' real cumulative index.  Format: 0.0%;-0.0%;0.0%
'Selected max drawdown' =
    VAR SeriesCode = [Selected series code]
    RETURN
        CALCULATE (
            MAX ( risk_summary[real_max_drawdown_peak_to_trough] ),
            REMOVEFILTERS ( dim_series ),
            risk_summary[series_code] = SeriesCode
        )

// [2 Selected series] Share of the 36 months in which the selected series beat that month's inflation.  Format: 0%
'Selected months beating inflation' =
    VAR SeriesCode = [Selected series code]
    RETURN
        CALCULATE (
            MAX ( risk_summary[pct_months_beat_inflation] ),
            REMOVEFILTERS ( dim_series ),
            risk_summary[series_code] = SeriesCode
        )

// [2 Selected series] Real return of the selected series, cumulative over 3 years.  Format: 0.0%;-0.0%;0.0%
'Selected real cum 3y' =
    VAR SeriesCode = [Selected series code]
    RETURN
        CALCULATE (
            MAX ( risk_summary[real_cum_3y] ),
            REMOVEFILTERS ( dim_series ),
            risk_summary[series_code] = SeriesCode
        )

// [3 Series values] Real growth of 100 invested at the end of 1402-06 (CPI = 100).  Format: 0.0
'Real growth index' =
    AVERAGE ( monthly_long[real_index_1402_06_eq_100] )

// [3 Series values] Nominal growth of 100 invested at the end of 1402-06.  Format: 0.0
'Nominal growth index' =
    AVERAGE ( monthly_long[nominal_index_1402_06_eq_100] )

// [3 Series values] Real return over the 12 months ending in the month (per year).  Format: 0.0%;-0.0%;0.0%
'Real return rolling 12m' =
    AVERAGE ( monthly_long[real_return_rolling_12m] )

// [3 Series values] Real return of one month.  Format: 0.0%;-0.0%;0.0%
'Real return per month' =
    AVERAGE ( monthly_long[real_return_per_month] )

// [3 Series values] Real CAGR over 36 months, per year.  Format: 0.0%;-0.0%;0.0%
'Real CAGR' =
    AVERAGE ( risk_summary[real_cagr] )

// [3 Series values] Bar colour for real returns: green above 0, red below 0, grey at 0. Used as conditional formatting (field value).
'Real CAGR color' =
    VAR RealCagr = [Real CAGR]
    RETURN
        SWITCH (
            TRUE (),
            ISBLANK ( RealCagr ), BLANK (),
            RealCagr > 0, "#2E7D32",
            RealCagr < 0, "#C62828",
            "#8C8C8C"
        )

// [3 Series values] Correlation of monthly real returns between two series (correlation_long, 36 months).  Format: 0.00
'Correlation (real, monthly)' =
    AVERAGE ( correlation_long[corr_real_return_per_month] )

// [3 Series values] Nominal CAGR over 36 months, per year.  Format: 0.0%;-0.0%;0.0%
'Nominal CAGR' =
    AVERAGE ( risk_summary[nominal_cagr] )

// [3 Series values] Real return, cumulative over 3 years.  Format: 0.0%;-0.0%;0.0%
'Real cum 3y' =
    AVERAGE ( risk_summary[real_cum_3y] )

// [3 Series values] Volatility of monthly real returns, annualized.  Format: 0.0%;-0.0%;0.0%
'Real vol per year' =
    AVERAGE ( risk_summary[real_vol_per_year] )

// [3 Series values] Largest peak-to-trough fall of the real cumulative index.  Format: 0.0%;-0.0%;0.0%
'Real max drawdown' =
    AVERAGE ( risk_summary[real_max_drawdown_peak_to_trough] )

// [3 Series values] Share of months beating that month's inflation.  Format: 0%
'Months beating inflation' =
    AVERAGE ( risk_summary[pct_months_beat_inflation] )

// [3 Series values] Real return of one 12-month block (per year).  Format: 0.0%;-0.0%;0.0%
'Real return per year (block)' =
    AVERAGE ( yearly_real[real_return_per_year] )

// [4 Closure] Nominal change over the window (cumulative).  Format: 0.0%;-0.0%;0.0%
'Closure nominal' =
    AVERAGE ( closure_summary[nominal] )

// [4 Closure] CPI change over the window, pro-rated to the dates.  Format: 0.0%;-0.0%;0.0%
'Closure CPI (pro-rated)' =
    AVERAGE ( closure_summary[cpi_prorated] )

// [4 Closure] Real change over the window, CPI pro-rated (primary).  Format: 0.0%;-0.0%;0.0%
'Closure real (pro-rated)' =
    AVERAGE ( closure_summary[real_prorated] )

// [4 Closure] CPI change over whole calendar months (sensitivity).  Format: 0.0%;-0.0%;0.0%
'Closure CPI (whole months)' =
    AVERAGE ( closure_summary[cpi_whole_months] )

// [4 Closure] Real change with whole-month CPI (sensitivity).  Format: 0.0%;-0.0%;0.0%
'Closure real (whole months)' =
    AVERAGE ( closure_summary[real_whole_months] )

// [5 Context] Median yield to maturity of government Murabaha bonds (اراد), per year. Forward-looking snapshot.  Format: 0.0%;-0.0%;0.0%
'Bond YTM' =
    MAX ( context[bond_ytm] )

// [5 Context] Trailing inflation, 12-month average, per year.  Format: 0.0%;-0.0%;0.0%
'Inflation 12m avg' =
    MAX ( context[inflation_12m_avg] )

// [5 Context] Trailing inflation, point to point over 12 months.  Format: 0.0%;-0.0%;0.0%
'Inflation point-to-point' =
    MAX ( context[inflation_point_to_point] )

// [5 Context] Implied real yield per year if inflation stays at last year's 12-month average.  Format: 0.0%;-0.0%;0.0%
'Bond real yield (avg)' =
    MAX ( context[real_yield_avg] )

// [5 Context] Implied real yield per year if inflation stays at last year's point-to-point rate.  Format: 0.0%;-0.0%;0.0%
'Bond real yield (p2p)' =
    MAX ( context[real_yield_p2p] )

// [5 Context] Source and snapshot date of the bond yield. Text.
'Bond source note' =
    "منبع: " & MAX ( context[source_url] ) & "  |  تاریخ داده: " & MAX ( context[snapshot_date] ) & UNICHAR ( 8207 )

// [5 Context] The bond comparison as a conditional sentence. Text.
'Bond conditional statement' =
    "اگر تورم در سطح سال گذشته بماند، بازده امروز اوراق دولتی به معنای بازده واقعی حدود "
        & FORMAT ( [Bond real yield (avg)], "0%" ) & " در سال است ("
        & FORMAT ( [Bond real yield (p2p)], "0%" ) & " در برابر تورم نقطه به نقطه)."
        & UNICHAR ( 8207 )
