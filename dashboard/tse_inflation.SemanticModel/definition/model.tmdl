model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	maxParallelismPerRefresh: 1
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "dim_series", "dim_month", "monthly_long", "risk_summary", "yearly_real", "closure_summary", "correlation_long", "context", "_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_series
ref table dim_month
ref table monthly_long
ref table risk_summary
ref table yearly_real
ref table closure_summary
ref table correlation_long
ref table context
ref table _Measures

ref cultureInfo en-US

