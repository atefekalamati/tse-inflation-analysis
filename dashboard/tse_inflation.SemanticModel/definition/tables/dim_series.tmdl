	partition dim_series = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_series.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"series_code", type text}, {"series", type text}, {"series_fa", type text}, {"series_short_fa", type text}, {"type", type text}, {"sector", type text}, {"usage_note", type text}, {"sort_order", Int64.Type}}, "en-US"),
